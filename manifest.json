{
  "manifest_version": 3,
  "name": "Messenger Ghost",
  "version": "3.3.0",
  "description": "Prevent others from seeing your typing indicator and read receipts, and block floating video mini-players on Facebook & Messenger.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.messenger.com/*",
    "https://messenger.com/*",
    "https://*.facebook.com/*",
    "https://facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.messenger.com/*",
        "https://messenger.com/*",
        "https://*.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": ["content/network_blocker.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.messenger.com/*",
        "https://messenger.com/*",
        "https://*.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": ["content/settings_sync.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
